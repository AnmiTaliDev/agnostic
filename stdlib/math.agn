package math

pub fn Max(a int, b int) int {
    if a > b {
        return a
    }
    return b
}

pub fn Min(a int, b int) int {
    if a < b {
        return a
    }
    return b
}

pub fn Pow(base int, exp int) int {
    if exp == 0 {
        return 1
    }

    var result int = 1
    var i int = 0

    for i < exp {
        result = result * base
        i = i + 1
    }

    return result
}

// Newton's method; positive integers only
pub fn Sqrt(n int) int {
    if n == 0 {
        return 0
    }
    if n == 1 {
        return 1
    }

    var x int = n / 2
    var prev int = 0
    var count int = 0

    for x != prev {
        if count > 20 {
            return x
        }
        prev = x
        x = (x + n / x) / 2
        count = count + 1
    }

    return x
}

// positive integers only
pub fn GCD(a int, b int) int {
    var x int = a
    var y int = b

    for y != 0 {
        var temp int = y
        y = x % y
        x = temp
    }

    return x
}

// positive integers only
pub fn LCM(a int, b int) int {
    if a == 0 {
        return 0
    }
    if b == 0 {
        return 0
    }

    return (a * b) / GCD(a, b)
}

pub fn Fact(n int) int {
    if n <= 1 {
        return 1
    }

    var result int = 1
    var i int = 2

    for i <= n {
        result = result * i
        i = i + 1
    }

    return result
}

pub fn IsEven(n int) int {
    if n % 2 == 0 {
        return 1
    }
    return 0
}

pub fn IsOdd(n int) int {
    if n % 2 != 0 {
        return 1
    }
    return 0
}

// 1 if x > 0, otherwise 0 -- negative input is not distinguished from zero
pub fn Sign(x int) int {
    if x > 0 {
        return 1
    }
    return 0
}

pub fn Clamp(value int, min int, max int) int {
    if value < min {
        return min
    }
    if value > max {
        return max
    }
    return value
}

pub fn SumRange(n int) int {
    return (n * (n + 1)) / 2
}

pub fn IsPrime(n int) int {
    if n <= 1 {
        return 0
    }
    if n <= 3 {
        return 1
    }
    if n % 2 == 0 {
        return 0
    }
    if n % 3 == 0 {
        return 0
    }

    var limit int = Sqrt(n)
    var i int = 5

    for i <= limit {
        if n % i == 0 {
            return 0
        }
        if n % (i + 2) == 0 {
            return 0
        }
        i = i + 6
    }

    return 1
}

pub fn Fib(n int) int {
    if n == 0 {
        return 0
    }
    if n == 1 {
        return 1
    }

    var a int = 0
    var b int = 1
    var i int = 2

    for i <= n {
        var temp int = a + b
        a = b
        b = temp
        i = i + 1
    }

    return b
}
